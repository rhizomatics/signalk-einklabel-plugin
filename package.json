{
  "name": "@rhizomatics/signalk-einklabel-plugin",
  "version": "1.2.3",
  "description": "Display SignalK data on eInk Electronic Shelf Labels, includes working examples for tide clock and watch schedule.",
  "keywords": [
    "ble",
    "display",
    "eink",
    "esl",
    "gicisky",
    "instrument",
    "signalk",
    "signalk-category-hardware",
    "signalk-category-instruments",
    "signalk-node-server-plugin",
    "tides",
    "watch-schedule",
    "zhsunyco"
  ],
  "homepage": "https://signalk-einklabel.rhizomatics.org.uk/",
  "bugs": {
    "url": "https://github.com/rhizomatics/signalk-einklabel-plugin/issues"
  },
  "license": "APACHE-2.0",
  "author": "jey burrows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhizomatics/signalk-einklabel-plugin.git"
  },
  "bin": {
    "esl-cli": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "cli": "ts-node src/cli/index.ts",
    "test": "node scripts/run-tests.js",
    "coverage": "node scripts/run-tests.js --coverage",
    "prepublishOnly": "npm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/roboto-serif": "^5.3.0",
    "@naugehyde/node-ble": "^1.13.5",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xmldom/xmldom": "^0.9.10",
    "commander": "^15.0.0",
    "form-data": "^4.0.6",
    "luxon": "^3.7.2",
    "mathjs": "^15.2.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.31.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "signalk": {
    "displayName": "eInk Label Displays",
    "appIcon": "docs/assets/icons/icon_tmp.png",
    "screenshots": [
      "docs/assets/screenshots/example_tidal_clock.png",
      "docs/assets/screenshots/example_watch_schedule.png",
      "docs/assets/screenshots/plugin_config.png",
      "docs/assets/screenshots/label_config.png"
    ],
    "recommends": [
      "signalk-watch-schedule",
      "signalk-tides",
      "@rhizomatics/signalk-einklabel-genai-plugin"
    ]
  }
}
